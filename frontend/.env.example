# Base URL of the backend API. If unset, the app calls "/api" on its own
# origin and relies on the Next.js rewrite proxy (API_BACKEND_URL) to reach
# the backend. Only set this when the frontend must call the backend
# cross-origin directly (e.g. custom domain setups).
NEXT_PUBLIC_API_URL=

# Backend origin used by the server-side rewrite proxy (runtime env).
API_BACKEND_URL=http://localhost:5000