# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin(s) allowed by CORS (comma-separated for multiple environments).
FRONTEND_URL=http://localhost:3000
# Base URL used to build public share links (usually the frontend origin).
PUBLIC_FILE_BASE_URL=http://localhost:3000

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# MUST be >= 32 chars in production (validated at boot).
JWT_SECRET=your_super_secret_jwt_key_change_in_production_0000
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Managed providers (Railway, Neon, RDS) can pass a single connection string;
# when set it overrides the field-by-field DB_* config below. sslmode is honored.
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filestorage
DB_USER=postgres
DB_PASSWORD=your_db_password
# Set to "true" for managed providers that require TLS (e.g. RDS, Neon).
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ─── Storage ────────────────────────────────────────────────────────────────
# "s3" (default) uses AWS S3; "local" stores files on disk under STORAGE_DIR
# (a Railway volume or the local ./data directory).
# STORAGE_DRIVER=local
# STORAGE_DIR=/data

# ─── AWS S3 ─────────────────────────────────────────────────────────────────
# If omitted, the default credential chain (IAM role, ~/.aws) is used.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-file-storage-bucket-dev
# Optional: use SSE-KMS instead of SSE-S3.
# S3_KMS_KEY_ID=arn:aws:kms:...

# ─── File Uploads ───────────────────────────────────────────────────────────
MAX_FILE_SIZE=104857600  # 100MB in bytes
SHARE_LINK_EXPIRY_DAYS=7

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # Maximum requests per window per IP

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info