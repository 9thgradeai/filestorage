# ─── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin(s) allowed by CORS (comma-separated for multiple environments).
FRONTEND_URL=http://localhost:3000
# Base URL used to build public share links (usually the frontend origin).
PUBLIC_FILE_BASE_URL=http://localhost:3000

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
# MUST be >= 32 chars in production (validated at boot).
JWT_SECRET=your_super_secret_jwt_key_change_in_production_0000
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# ─── Email / OTP ────────────────────────────────────────────────────────────
# Email delivery needs one provider in production:
#   1. Resend HTTPS API (recommended; works on all Railway plans including
#      Free/Trial/Hobby where outbound SMTP is blocked). Sign up at
#      https://resend.com, verify a domain, and set RESEND_API_KEY.
#   2. SMTP relay (Railway Pro and above only).
#
# Resend (preferred when RESEND_API_KEY is set):
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_NAME=Vault
# Must be an address on your verified Resend domain (e.g. no-reply@yourdomain.com).
EMAIL_FROM_EMAIL=no-reply@example.com

# SMTP (fallback provider):
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=true          # true for port 465, false (STARTTLS) for 587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=Vault
SMTP_FROM_EMAIL=noreply@example.com
# SMTP_TLS_REJECT_UNAUTHORIZED=false   # only if your relay uses a self-signed cert

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Managed providers (Railway, Neon, RDS) can pass a single connection string;
# when set it overrides the field-by-field DB_* config below. sslmode is honored.
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=filestorage
DB_USER=postgres
DB_PASSWORD=your_db_password
# Set to "true" for managed providers that require TLS (e.g. RDS, Neon).
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ─── Storage ────────────────────────────────────────────────────────────────
# "s3" (default) uses AWS S3; "local" stores files on disk under STORAGE_DIR
# (a Railway volume or the local ./data directory).
# STORAGE_DRIVER=local
# STORAGE_DIR=/data

# ─── AWS S3 ─────────────────────────────────────────────────────────────────
# If omitted, the default credential chain (IAM role, ~/.aws) is used.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-file-storage-bucket-dev
# Optional: use SSE-KMS instead of SSE-S3.
# S3_KMS_KEY_ID=arn:aws:kms:...

# ─── File Uploads ───────────────────────────────────────────────────────────
MAX_FILE_SIZE=104857600  # 100MB in bytes
SHARE_LINK_EXPIRY_DAYS=7

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # Maximum requests per window per IP

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info